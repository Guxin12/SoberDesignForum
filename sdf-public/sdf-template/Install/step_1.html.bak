<html>
<head>
    <title>第一步 - 安装数据库</title>
    <meta charset="utf-8" />
    <meta name="keywords" content="install,安装,SDF管理系统" />
    <meta name="description" content="SDF安装页面" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <link rel="stylesheet" href="./sdf-public/sdf-assets/css/style.css"/>
</head>
<body>
<s-page theme="auto">
    <s-appbar>
        <div slot="headline"> 第一步 - 安装数据库 </div>
    </s-appbar>
    
    <form action="./sdf-public/sdf-core/install.php" method="post" id="installForm">
        <!-- 隐藏字段用于传递值 -->
        <input type="hidden" name="host" id="realHost" value="localhost">
        <input type="hidden" name="port" id="realPort" value="3306">
        <input type="hidden" name="dbname" id="realDbname">
        <input type="hidden" name="dbusername" id="realUsername">
        <input type="hidden" name="dbpassword" id="realPassword">
        <input type="hidden" name="step" value="1">

        <s-card style="display: block; height: none; max-width: none; margin : 10px;padding: 24px">
            请在下方填写你的数据库连接信息
            <br><br>
            
            <s-text-field 
                label="数据库地址" 
                type="text"
                data-name="Host"
                value="localhost"
                onchange="document.getElementById('realHost').value = this.value"
            ></s-text-field>
            
            <s-text-field 
                label="数据库端口" 
                type="text"
                data-name="Port"
                value="3306"
                onchange="document.getElementById('realPort').value = this.value"
            ></s-text-field>

            
            <s-text-field 
                label="数据库名" 
                type="text"
                data-name="Dbname"
                onchange="document.getElementById('realDbname').value = this.value"
            ></s-text-field>

            
            <s-text-field 
                label="数据库用户名" 
                type="text"
                data-name="Username"
                onchange="document.getElementById('realUsername').value = this.value"
            ></s-text-field>

            
            <s-text-field 
                label="数据库密码" 
                type="password"
                data-name="Password"
                onchange="document.getElementById('realPassword').value = this.value"
            ></s-text-field>


            <s-button 
                type="filled"
                onclick="submitForm()"
                style="display: flex"
            >下一步</s-button>
        </s-card>
    </form>
</s-page>

<script>
function submitForm() {
  // 确保所有字段都有值
  let valid = true;
  document.querySelectorAll('s-text-field').forEach(field => {
    if(!field.value) {
      valid = false;
    }
  });
  
  if(valid) {
    document.getElementById('installForm').submit();
  } else {
    alert("请填写所有字段");
  }
}
</script>


<script src="./sdf-public/sdf-assets/js/jquery.min.js"></script>
<script src="./sdf-public/sdf-assets/js/sober.js"></script>
<script src="./sdf-public/sdf-assets/js/vue.js"></script>

</body>
</html>